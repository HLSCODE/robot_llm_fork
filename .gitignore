# --- 模型权重与大文件 ---
*.pt
*.pth
*.onnx
*.weights
*.h5
*.pb

# 默认忽略运行时数据，仅保留版本化的回归测试基线
data/
!data/
data/*
!data/regression/
!data/regression/llm_planning_cases.json
!data/regression/performance_budgets.json
temp_models/
models/*
!models/kws/
models/kws/*
!models/kws/README.md
!models/kws/keywords.txt
!models/kws/keywords_raw.txt
!models/kws/keywords.example.txt

# --- Python 缓存、测试产物与覆盖率 ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.Python
.mypy_cache/
.pytest_cache/
.pytest-application-data-*/
.ruff_cache/
.coverage
coverage.xml
performance-report.json
htmlcov/

# --- 本地配置与虚拟环境 ---
config/config.toml
config/fragments/*.toml
!config/fragments/*.example.toml
config/fragments/**/*.toml
!config/fragments/**/*.example.toml
env/
venv/
.env
.venv
pip-log.txt
pip-delete-this-directory.txt

# --- 编辑器与 IDE 配置 ---
.vscode/
.idea/
*.swp
*.swo

# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db

# --- 日志文件 ---
*.log
logs/
