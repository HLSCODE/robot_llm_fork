# ============================================================
# Robot Action Orchestrator - 配置文件模板
# ============================================================
# 使用说明
# ============================================================
#
# 1. 复制此文件为 config.env：
#    cp config.env.example config.env
#
# 2. 根据实际情况修改配置值
#
# 3. 设置运行模式（在 config.env 中设置 RUN_MODE）：
#    RUN_MODE=gui    → 启动 PyQt6 图形界面
#    RUN_MODE=server → 启动 WebSocket 服务
#
#    或者通过命令行环境变量覆盖：
#    RUN_MODE=gui python run.py
#    RUN_MODE=server python run.py --port 9000
#
# 4. 在代码中使用配置：
# ============================================================

# ============================================================
# Robot Action Orchestrator - 统一配置文件
# ============================================================

# ------------------------------------------------------------
# LLM / AI 配置
# ------------------------------------------------------------
# 配置分层：
# 1. Provider 路由：决定聊天、规划、视觉等能力使用哪个模型提供商
# 2. OpenAI-compatible：OpenAI / DeepSeek / 阿里云百炼等 HTTP 接口
# 3. MiniCPM Realtime：MiniCPM-o WebSocket Realtime Chat 接口
# 4. 指令分类：判断用户输入是否需要触发机器人动作规划

# 默认 provider。TaskProfile.default_provider 或调用时 provider 参数可以覆盖。
# 支持: openai / deepseek / dashscope / minicpm
LLM_DEFAULT_PROVIDER=dashscope

# LLM 默认调用参数（TaskProfile 未覆盖时使用）
LLM_DEFAULT_TEMPERATURE=0.3
LLM_DEFAULT_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT_S=60

# --- OpenAI-compatible provider 配置 ---
# 适用于 openai / deepseek / dashscope，以及其他兼容 OpenAI Chat Completions 的服务。
OPENAI_API_KEY=

# API Base URL（可选，留空使用各 provider 默认地址）
# OpenAI:    https://api.openai.com/v1
# DeepSeek:  https://api.deepseek.com/v1
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
# OpenAI:    gpt-4o, gpt-4o-mini, gpt-4-turbo
# DeepSeek:  deepseek-reasoner, deepseek-chat
# 阿里云百炼：qwen-plus, qwen-turbo, qwen-max, qwen-long
OPENAI_MODEL=qwen-turbo

# --- MiniCPM Realtime provider 配置 ---
# 当 LLM_DEFAULT_PROVIDER、TaskProfile.default_provider 或调用 provider=minicpm 时使用。
# MiniCPM 网关地址（运行 MiniCPM-o Realtime 服务的主机）
# MINICPM_GATEWAY_HOST=minicpm.example.com
MINICPM_GATEWAY_HOST=10.10.17.15
MINICPM_GATEWAY_PORT=8006

# MiniCPM WebSocket 协议：wss 或 ws
MINICPM_WS_SCHEME=wss

# 外网反向代理路径前缀（本地直连时留空；走外网时可填 /minicpm 等）
MINICPM_GATEWAY_PATH_PREFIX=

# MiniCPM Realtime Chat 路径。最终连接为：
# {MINICPM_WS_SCHEME}://HOST:PORT{PATH_PREFIX}{REALTIME_PATH}?mode=chat
MINICPM_REALTIME_PATH=/v1/realtime

# MiniCPM Realtime provider 的显示模型名
MINICPM_MODEL=minicpm-o

# --- 指令分类配置 ---
# true = 先用 LLM 判断用户输入是否为可执行机器人指令
# 注意：MINICPM_ASK_* 是历史命名，现在表示“指令分类模型”，不等同于 MiniCPM provider。
MINICPM_ASK_ENABLED=true

# 指令分类模型使用 OpenAI-compatible 接口；留空则复用 OPENAI_* 配置
MINICPM_ASK_API_KEY=
MINICPM_ASK_BASE_URL=
MINICPM_ASK_MODEL=qwen-turbo

# --- 唤醒后语音会话配置 ---
# 关闭真实语音输入时，GUI 底部文本对话仍可直接使用。
VOICE_SESSION_TIMEOUT_S=30
# 通用对话发送给 LLM 的最大历史轮数；0 表示关闭上下文记忆
VOICE_SESSION_HISTORY_TURNS=6
# GUI 启动时 ASR+KWS 最多优先等待多久；超时后先初始化 Robot，语音仍在后台继续加载
VOICE_SPEECH_STARTUP_WAIT_TIMEOUT_S=30
VOICE_AUTO_EXECUTE_COMMAND=false
VOICE_TTS_ENABLED=false
VOICE_INPUT_ENABLED=false

# 真实语音输入配置（VOICE_INPUT_ENABLED=true 时使用，包含唤醒词 + ASR）
VOICE_AUDIO_SAMPLE_RATE=16000
VOICE_AUDIO_CHANNELS=1
VOICE_AUDIO_BLOCK_MS=100
VOICE_AUDIO_QUEUE_SIZE=300
# sounddevice 输入设备 id 或名称；留空使用系统默认输入设备
VOICE_AUDIO_DEVICE=
# sounddevice latency，可选 high / low / 秒数
VOICE_AUDIO_LATENCY=high
VOICE_AUDIO_SHOW_STATUS=false

# VAD / 断句配置
VOICE_VAD_MODEL=fsmn-vad
VOICE_VAD_CHUNK_MS=200
VOICE_MIN_UTTERANCE_MS=500
VOICE_MAX_UTTERANCE_MS=30000
VOICE_END_SILENCE_MS=800
# FunASR VAD 判定说话后，还需满足此 RMS 才开始收集语音
VOICE_SPEECH_START_RMS_THRESHOLD=0.025
# 连续满足起始能量门限的分片数；每个分片默认 200ms
VOICE_SPEECH_START_CONFIRM_CHUNKS=1
# 刚唤醒但尚未识别到用户输入时的等待时长
VOICE_LISTENING_TIMEOUT_S=8.0
# 已识别到有效用户输入后，每轮回复等待追问的时长
VOICE_FOLLOW_UP_LISTENING_TIMEOUT_S=25.0
VOICE_WAKE_COOLDOWN_S=1.5
# 唤醒成功后使用 REPEAT_PROFILE 生成的流式语音反馈
VOICE_WAKE_FEEDBACK_ENABLED=true
VOICE_WAKE_FEEDBACK_TEXT=明德博士在，请说。
# 真实唤醒后异步执行的欢迎 task；任务不存在、为空或执行器忙时自动跳过
VOICE_WAKE_WELCOME_ENABLED=false
VOICE_WAKE_WELCOME_TASK=
VOICE_SILENCE_RMS_THRESHOLD=0.01
VOICE_SUPPRESS_MODEL_OUTPUT=true
VOICE_SHOW_ASR_TIMING=false

# FunASR 语音识别配置
VOICE_ASR_MODEL=iic/SenseVoiceSmall
VOICE_ASR_PUNC_MODEL=ct-punc
# 当前默认使用 CPU；如需 GPU，可配置 cuda:0 并安装匹配的 torch
VOICE_ASR_DEVICE=
VOICE_ASR_BATCH_SIZE_S=60

# 唤醒词配置（VOICE_INPUT_ENABLED=true 时使用）
# 支持: sherpa / dummy / openwakeword
VOICE_WAKE_ENGINE=sherpa
# 仅 VOICE_WAKE_ENGINE=dummy 时生效；true 表示收到音频后自动触发一次唤醒，便于调试。
VOICE_WAKE_AUTO_TRIGGER=false
VOICE_KWS_ENCODER=models/kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20/encoder-epoch-13-avg-2-chunk-16-left-64.onnx
VOICE_KWS_DECODER=models/kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20/decoder-epoch-13-avg-2-chunk-16-left-64.onnx
VOICE_KWS_JOINER=models/kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20/joiner-epoch-13-avg-2-chunk-16-left-64.onnx
VOICE_KWS_TOKENS=models/kws/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20/tokens.txt
VOICE_KWS_KEYWORDS_FILE=models/kws/keywords.txt
VOICE_KWS_PROVIDER=cpu
VOICE_KWS_THRESHOLD=0.35
VOICE_KWS_SCORE=1.5
VOICE_KWS_NUM_THREADS=1
VOICE_KWS_MAX_ACTIVE_PATHS=4
VOICE_OPENWAKEWORD_MODEL_PATHS=
VOICE_OPENWAKEWORD_THRESHOLD=0.6

# ------------------------------------------------------------
# 系统配置
# ------------------------------------------------------------
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 运行模式 (gui / server)
# gui: PyQt6 图形界面模式
# server: WebSocket 服务模式（默认）
RUN_MODE=gui

# 模拟模式 (true/false) - 开启后不连接真实硬件
SIMULATION_MODE=false

# 技能库路径
SKILL_LIBRARY_PATH=data/skills/skill_library.json

# ------------------------------------------------------------
# 相机配置
# ------------------------------------------------------------
# 相机管理器类型: realsense（Intel RealSense）/ webcam（本地 USB/内置摄像头）
CAMERA_PROVIDER=realsense

# --- RealSense 配置（CAMERA_PROVIDER=realsense 时生效）---
# 相机序列号，多台用逗号分隔（不填则不启动任何相机，不自动发现）
REALSENSE_DEVICE_SN=419522071147,420122071087,250222072950,327122072448
# 相机名称，与序列号一一对应，多台用逗号分隔（留空则用序列号作为名称）
REALSENSE_DEVICE_NAMES=monitor1,monitor2,monitor3,monitor4

# --- OpenCV/Webcam 配置（CAMERA_PROVIDER=webcam 时生效）---
# 摄像头索引，多个用逗号分隔（默认 0）
WEBCAM_DEVICE_INDEXES=0
# 摄像头名称，与索引一一对应，多个用逗号分隔（留空则用 webcam-{index} 作为名称）
WEBCAM_DEVICE_NAMES=

# 相机服务端口（用于从 GUI 获取帧）
VISION_CAMERA_HOST=localhost
VISION_CAMERA_PORT=12345

# YOLO 和 SAM 模型路径
YOLO_MODEL_PATH=models/best.pt
SAM_MODEL_PATH=models/sam2.1_l.pt

# 调试图片保存目录
VISION_DEBUG_SAVE_DIR=pictures

# 手眼标定参数（相机→末端变换，9 个值按行展开为 3×3 矩阵）
VISION_ROTATION_MATRIX=0.00215684,0.97503835,0.22202606,-0.99995231,-0.0000119,0.00976617,0.00952503,-0.22203654,0.97499182
VISION_TRANSLATION_VECTOR=-0.10273135,0.03312807,-0.07214614
VISION_GRIPPER_OFFSET=3.146,0.0,3.128

# 视觉抓取默认参数
VISION_DEFAULT_CONFIDENCE=0.7
VISION_DEFAULT_VELOCITY=15
VISION_DEFAULT_GRIPPER_LENGTH=150.0
VISION_DEFAULT_WORKFLOW=bottle
VISION_CAMERA_NAME=monitor1
VISION_PREP_OFFSET_X=-0.07
VISION_GRASP_Z=-0.24
VISION_GMM_COMPONENTS=1

# ------------------------------------------------------------
# 机械臂 RM75 配置
# ------------------------------------------------------------
# Robot1 配置（左手）
ROBOT1_IP=192.168.3.18
ROBOT1_PORT=8080
ROBOT1_INITIAL_POSE=-0.04844,-0.269769,-0.101888,3.109,-0.094,-1.592

# Robot2 配置（右手）
ROBOT2_IP=192.168.3.19
ROBOT2_PORT=8080
ROBOT2_INITIAL_POSE=-0.053437,0.24741,-0.120801,3.114,-0.032,-2.935

#
MOVE_CONTROLLER_HOST = 192.168.3.216
MOVE_CONTROLLER_PORT = 12345
MOVE_CONTROLLER_CLIEN_BIND_PORT = 54321

# 移动速度配置
MOVE_SPEED=10
MOVE_VELOCITY=10
MOVE_RADIUS=0
MOVE_CONNECT=0
MOVE_BLOCK=1

# 最大尝试次数
MAX_ATTEMPTS=5

# 夹爪配置
GRIPPER_PICK_SPEED=200
GRIPPER_PICK_FORCE=1000
GRIPPER_PICK_TIMEOUT=3
GRIPPER_RELEASE_SPEED=100
GRIPPER_RELEASE_TIMEOUT=3

# ------------------------------------------------------------
# 串口设备配置
# ------------------------------------------------------------
# 身体控制器（ModbusMotor）
BODY_DI_PAN=false
BODY_SERIAL_PORT=/dev/body
BODY_BAUDRATE=115200
BODY_SLAVE_ID=1
BODY_TIMEOUT=1

# 快换手（Kuaihuanshou）
KUAIHUANSHOU_SERIAL_PORT=/dev/hand
KUAIHUANSHOU_BAUDRATE=115200
KUAIHUANSHOU_TIMEOUT=3

# ADP 吸液枪
ADP_SERIAL_PORT=/dev/hand
ADP_BAUDRATE=115200
ADP_TIMEOUT=5
ADP_MAX_RETRIES=3

# 继电器控制器
RELAY_SERIAL_PORT=/dev/power
RELAY_BAUDRATE=38400
RELAY_TIMEOUT=1

# ------------------------------------------------------------
# 表情屏 T5L DGUSII 配置（可选，按需调用）
# ------------------------------------------------------------
# 默认关闭，不会在项目启动时初始化串口；只有执行表情切换时才会连接
EXPRESSION_DISPLAY_ENABLED=false
# 显示屏通信策略。新增屏幕时在 src/expression_display/ 下添加同级 provider 并注册
EXPRESSION_DISPLAY_PROVIDER=t5l_dgusii
# 可选：如需继续使用 JSON 配置，填写项目内稳定路径；留空则使用下面的平铺配置
EXPRESSION_DISPLAY_CONFIG=
EXPRESSION_DISPLAY_SERIAL_PORT=COM4
EXPRESSION_DISPLAY_BAUDRATE=115200
EXPRESSION_DISPLAY_TIMEOUT=0.5
EXPRESSION_DISPLAY_WRITE_TIMEOUT=1.0
EXPRESSION_DISPLAY_VP_ADDR=0x5600
EXPRESSION_DISPLAY_SP_ADDR=0x8000
EXPRESSION_DISPLAY_START_VALUE=0x0000
EXPRESSION_DISPLAY_STOP_VALUE=0x0001
EXPRESSION_DISPLAY_HIDE_VALUE=0x0002
EXPRESSION_DISPLAY_CLEAR_BEFORE_SWITCH=stop
EXPRESSION_DISPLAY_SWITCH_DELAY=0.1
EXPRESSION_DISPLAY_UPDATE_ICON_RANGE=true
# 格式：name:icon_lib:icon_start:icon_end，多个用英文逗号分隔
EXPRESSION_DISPLAY_EXPRESSIONS=happy:24:0:63,sad:27:0:63,angry:30:0:63,speechless:33:0:63,default_1:36:0:63,default_2:39:0:63
# 切换前需要额外隐藏的旧 VP，多个用英文逗号分隔，例如：0x5600,0x5604
EXPRESSION_DISPLAY_CLEAR_VPS=
EXPRESSION_DISPLAY_TEST_INTERVAL=1.5
EXPRESSION_DISPLAY_TX_DELAY=0.05

# # ------------------------------------------------------------
# WebSocket 服务器配置
# ------------------------------------------------------------
# WebSocket 服务端口
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# ------------------------------------------------------------
# 枪头更换位置配置（末端位姿，单位：米）
# ------------------------------------------------------------
# 枪头 1 位置（第一列）
GUN1_1SHANG=-0.119418, -0.088287, -0.380201, 3.110000, 0.001000, -2.893000
GUN1_1XIA=-0.119418, -0.088287, -0.480201, 3.110000, 0.001000, -2.893000
GUN1_1ZHONG=-0.119418, -0.088287, -0.455201, 3.110000, 0.001000, -2.893000

# 枪头 2 位置（第二列）
GUN2_2SHANG=-0.117419, -0.066539, -0.380577, 3.135000, -0.009000, -2.869000
GUN2_2XIA=-0.117419, -0.066539, -0.480577, 3.135000, -0.009000, -2.869000
GUN2_2ZHONG=-0.117419, -0.066539, -0.465577, 3.135000, -0.009000, -2.869000
#[-0.119019, -0.080658, -0.478937, 3.136000, -0.001000, -2.870000]
# ------------------------------------------------------------
# 其他位置配置
# ------------------------------------------------------------
# 初始位置
INITIAL_POSE=-0.303379,0.274441,-0.075986,-3.081,0.137,-1.828
LEFT_INITIAL_POSE=-0.356,0.309,-0.186,-3.141,0,-1.89
RIGHT_INITIAL_POSE=-0.372,0.221,-0.186,-3.121,0,-1.89

# 放置位置
PLACE_DROP_HEIGHT=0.06
PLACE_ABOVE=0.0637,-0.07351,-0.4182,3.15,0,1.617
PLACE_POS2=0.285488,-0.256408,-0.090654,3.14,0,1.5
