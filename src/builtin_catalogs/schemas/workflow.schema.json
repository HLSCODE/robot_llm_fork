{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-llm.local/schemas/workflow.schema.json",
  "title": "Robot LLM Workflow Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schema_version",
    "workflow_id",
    "name",
    "revision",
    "root",
    "presentation"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "robot_llm.workflow"},
    "schema_version": {"const": 2},
    "workflow_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "root": {"$ref": "#/$defs/rootSequence"},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions"],
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/position"}
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "rootSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": {"const": "sequence"},
        "children": {
          "type": "array",
          "items": {"oneOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/loop"}]}
        }
      }
    },
    "actionSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": {"const": "sequence"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/action"}}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "item_uuid", "definition"],
      "properties": {
        "kind": {"const": "action"},
        "node_id": {"type": "string", "minLength": 1},
        "item_uuid": {"type": "string", "minLength": 1},
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "type", "parameters"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "loop_uuid", "repeat_count", "body"],
      "properties": {
        "kind": {"const": "loop"},
        "node_id": {"type": "string", "minLength": 1},
        "loop_uuid": {"type": "string", "minLength": 1},
        "repeat_count": {"type": "integer", "minimum": 2},
        "body": {"$ref": "#/$defs/actionSequence"}
      }
    }
  }
}
