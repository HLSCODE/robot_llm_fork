{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robot-llm.local/schemas/workflow.schema.json",
  "title": "Robot LLM Workflow Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "schema_version", "robot_profile_id", "workflow_id", "name", "revision", "root", "presentation"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "robot_llm.workflow"},
    "schema_version": {"const": 5},
    "robot_profile_id": {"type": "string", "minLength": 1},
    "workflow_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "root": {"$ref": "#/$defs/sequence"},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions"],
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/position"}
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "children"],
      "properties": {
        "kind": {"const": "sequence"},
        "children": {
          "type": "array",
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/action"},
              {"$ref": "#/$defs/loop"},
              {"$ref": "#/$defs/parallel"},
              {"$ref": "#/$defs/subworkflow"}
            ]
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "item_uuid", "definition"],
      "properties": {
        "kind": {"const": "action"},
        "node_id": {"type": "string", "minLength": 1},
        "item_uuid": {"type": "string", "minLength": 1},
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["robot_profile_id", "id", "name", "type", "parameters"],
          "properties": {
            "robot_profile_id": {"type": "string", "minLength": 1},
            "id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1},
            "type": {"type": "string", "minLength": 1},
            "parameters": {"type": "object"}
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "loop_uuid", "repeat_count", "body"],
      "properties": {
        "kind": {"const": "loop"},
        "node_id": {"type": "string", "minLength": 1},
        "loop_uuid": {"type": "string", "minLength": 1},
        "repeat_count": {"type": "integer", "minimum": 2},
        "body": {"$ref": "#/$defs/sequence"}
      }
    },
    "parallelBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_id", "body"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1},
        "body": {"$ref": "#/$defs/sequence"}
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "parallel_uuid", "join_policy", "failure_policy", "branches"],
      "properties": {
        "kind": {"const": "parallel"},
        "node_id": {"type": "string", "minLength": 1},
        "parallel_uuid": {"type": "string", "minLength": 1},
        "join_policy": {"const": "all"},
        "failure_policy": {"const": "cancel_all"},
        "branches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/parallelBranch"}
        }
      }
    },
    "subworkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "node_id", "subworkflow_uuid", "name", "source_workflow_id", "source_revision", "body"],
      "properties": {
        "kind": {"const": "subworkflow"},
        "node_id": {"type": "string", "minLength": 1},
        "subworkflow_uuid": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "source_workflow_id": {"type": "string"},
        "source_revision": {"type": "integer", "minimum": 0},
        "body": {"$ref": "#/$defs/sequence"}
      }
    }
  }
}
